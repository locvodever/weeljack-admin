{
  "name": "weeljack-admin",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "ng serve --port 4200",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && ngc --noEmit -p tsconfig.spec.json",
    "build": "ng build",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:licences": "node --test scripts/check-licences.test.mjs && node scripts/check-licences.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:a11y && npm run check:licences"
  },
  "dependencies": {
    "@angular/cdk": "~22.3.0",
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/platform-server": "~22.3.0",
    "@angular/router": "~22.3.0",
    "@angular/ssr": "~22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/css": "^2.0.1",
    "@vitest/browser-playwright": "^5.1.0",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  }
}
